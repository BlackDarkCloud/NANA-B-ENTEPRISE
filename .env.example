# --- Database (Neon Postgres) ---
# Get these from your Neon project dashboard -> Connection Details
# DATABASE_URL: pooled connection (used by the running app, via PgBouncer)
DATABASE_URL="postgresql://neondb_owner:npg_UlVMQS32vFyR@ep-morning-dew-axwhldcd.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: direct (non-pooled) connection, used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/nanab?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Paystack ---
# From https://dashboard.paystack.com/#/settings/developers
# Use test keys (sk_test_..., pk_test_...) until you're ready to go live
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- App ---
# The full public URL of your deployed site (no trailing slash)
# Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed script (optional, used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@nanab.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
